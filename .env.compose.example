# docker compose 변수 - `cp .env.compose.example .env` 후 값을 채운다 (.env는 gitignore됨).
# 비밀번호/시크릿은 URL에 들어가므로 영숫자만 쓴다. 예: openssl rand -hex 24

POSTGRES_USER=newsletter
POSTGRES_PASSWORD=change-me-hex-only
POSTGRES_DB=newsletter
API_SECRET_KEY=change-me-hex-only

# 호스트 루프백에 노출할 포트
DB_HOST_PORT=5433
API_HOST_PORT=8000

# LLM 킬 스위치 파일이 있는 디렉터리(호스트 비용 가드가 LLM_KILL_SWITCH를 만드는 곳).
# 워크트리에서 띄울 때는 메인 체크아웃의 .ops 절대경로를 넣는다.
OPS_DIR=./.ops

# generate 잡을 켤 때만: LLM 키 파일
# AI_ENV_FILE=ai_workspace/.env

# 실패 알림(선택)
# SLACK_WEBHOOK_URL=

# 정책브리핑 정책뉴스 수집(선택, 공공누리 제1유형 - docs/adr/0023). 공공데이터포털 데이터셋 15095335
# 활용신청 후 받은 "일반 인증키(Decoding)". 비워 두면 ingest가 이 출처만 건너뛴다.
# DATA_GO_KR_SERVICE_KEY=

# Mac(colima) 개발: 호스트 HF 캐시의 BGE-M3 재사용
# COMPOSE_FILE=docker-compose.yml:docker/compose.mac.yaml

# job_runs.git_sha에 남길 커밋 (빌드 전에: export GIT_SHA=$(git rev-parse HEAD))
# GIT_SHA=
