# AI Workspace - LangGraph News Pipeline

# ========== LLM Provider ==========
# 'naver' for HyperCLOVA X, 'openai' for OpenAI GPT
LLM_PROVIDER=naver

# ========== Naver HyperCLOVA X API ==========
# Apps 방식 (nv-로 시작하는 키): API 키 하나만 설정
# Legacy 방식: 두 키 모두 설정 필요
NCP_CLOVASTUDIO_API_KEY=nv-your-api-key-here
# NCP_APIGW_API_KEY=your-apigw-key-here  # Legacy 방식일 때만 필요
# 지원 모델: HCX-003, HCX-DASH-001
HYPERCLOVA_MODEL=HCX-003

# ========== OpenAI API (Fallback) ==========
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ========== Database Configuration (PostgreSQL with pgvector) ==========
DB_HOST=localhost
DB_PORT=5432
DB_USER=recsys01
DB_PASSWORD=your-db-password-here
DB_NAME=final_db

# ========== Environment ==========
# dev, staging, prod
ENV=dev
