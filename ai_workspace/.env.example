# AI Workspace - LangGraph News Pipeline

# ========== LLM 클라이언트 (core/llm/, ADR 0005) ==========
# role(generator/judge/tone)별로 프로바이더/모델을 독립적으로 고른다.
# 프로바이더: openai | gemini | upstage | naver(레거시, 기본값 아님)
#
# 지금 기본으로 발급받은 키는 Gemini(Google Cloud 크레딧)뿐이므로, GEN/JUDGE/TONE
# 세 role 모두 gemini가 기본 프로바이더다 - 아래 GEMINI_API_KEY 하나만 있어도
# 파이프라인 전체가 동작한다. judge는 generator와 "다른 모델"(Flash vs
# Flash-Lite)을 기본값으로 쓰지만, 같은 벤더(gemini) 계열이라는 점 자체가
# LLM-as-judge의 self-preference bias 위험 요인이라 이 조합으로 judge를 만들 때마다
# WARNING 로그가 남는다(core/llm/registry.py::get_client) - 최종 프로바이더/모델
# 조합은 별도 bake-off ADR로 정한다.
#
# 모델을 비워두면 core/llm/registry.py의 ROLE_DEFAULT_MODEL/PROVIDER_CONFIG
# 기본값을 쓰지만, 운영에서는 아래처럼 명시하는 것을 권장한다. 모델 id는
# https://ai.google.dev/gemini-api/docs/models (접근일 2026-09-25) 기준 유효한
# id다 - 근거는 docs/adr/0005 참고.
#
# GEN_PROVIDER=gemini
# GEN_MODEL=gemini-3.5-flash-lite   # 초안 생성 - 비용 효율 우선
#
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-3.1-flash-lite # 평가 - generator와 다른 모델 (3.5-flash는 2026-09-25 프로브에서 타임아웃/503)
#
# TONE_PROVIDER=gemini
# TONE_MODEL=gemini-3.5-flash-lite  # 문체 변환 - 생성과 비슷한 비용 프로필

# ---------- Google Gemini (OpenAI 호환 엔드포인트) ----------
# https://generativelanguage.googleapis.com/v1beta/openai/ - AI Studio에서 키 발급
GEMINI_API_KEY=your-gemini-api-key-here

# ---------- 다른 프로바이더로 challenger를 시도할 때만 (선택) ----------
# JUDGE_PROVIDER/GEN_PROVIDER/TONE_PROVIDER를 openai 또는 upstage로 명시하지
# 않는 한 아래 키들은 필요 없다.

# Upstage Solar (OpenAI 호환 엔드포인트, 한국어 특화)
# https://api.upstage.ai/v1 - console.upstage.ai에서 키 발급
UPSTAGE_API_KEY=your-upstage-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------- 프로바이더별 레이트리밋(선택) ----------
# 초 단위 최소 호출 간격. 프로바이더당 클라이언트 인스턴스를 공유하므로
# (core/llm/registry.py) 여기서 설정하면 해당 프로바이더의 모든 role에 적용된다.
# GEMINI_LLM_MIN_INTERVAL=0.0
# UPSTAGE_LLM_MIN_INTERVAL=0.0
# OPENAI_LLM_MIN_INTERVAL=0.0

# ========== LLM 킬 스위치 (예정된 비용 가드용) ==========
# 실제 Google Cloud 과금이 시작되는 걸 감지하면 cron이 이 스위치를 켜서 모든 LLM
# 호출을 즉시 막는다(core/llm/kill_switch.py) - "1"/"true"/"yes" 중 하나면 켜짐.
# LLM_KILL_SWITCH=0
#
# 또는 아래 파일을 만들면(내용은 무관) 켜진다 - 기본 경로는 저장소 루트 기준
# <repo root>/.ops/LLM_KILL_SWITCH이며, 이 변수로 다른 경로를 지정할 수 있다.
# LLM_KILL_SWITCH_FILE=.ops/LLM_KILL_SWITCH

# ========== LLM 지출 상한 (docs/adr/0035) ==========
# 클라이언트가 요청마다 최악 비용을 원장에 예약하고, 상한을 넘으면 요청을 보내기 전에 멈춘다.
# 전부 선택 - 비워 두면 아래 기본값(작게 잡은 값)이다. 끄는 스위치는 없고 상한을 올릴 수만 있다.
# 값이 숫자로 읽히지 않으면 기본값으로 넘어가지 않고 모든 LLM 호출을 거부한다.
# 금액은 세전 USD. 확인: python -m core.llm.spend_cli summary / estimate --plan ...
# LLM_BUDGET_RUN_USD=0.20      # 런 1회(Stage5 배치 1회, 또는 LLM_RUN_ID가 같은 실행들)
# LLM_BUDGET_DAY_USD=0.30      # 하루(LLM_BUDGET_DAY_TZ 기준). 넘으면 킬 스위치 파일도 만든다
# LLM_BUDGET_TOTAL_USD=3.00    # 원장 전체. 넘으면 킬 스위치 파일도 만든다
# LLM_BUDGET_DAY_TZ=Asia/Seoul
# 원장 파일. 기본은 <메인 체크아웃>/.ops/llm_spend_ledger.jsonl - 워크트리에서 돌려도 같은 파일이다.
# 다른 기기(Colab 등)는 자기 원장을 따로 가지므로 전체 상한을 기기 수만큼 나눠 잡아야 한다.
# LLM_SPEND_LEDGER_FILE=
# 여러 프로세스(재개 포함)를 한 런 상한으로 묶을 때만
# LLM_RUN_ID=
# 단가표(config/llm_pricing.yaml)에 없는 모델은 거부한다. 임시로 허용하려면 둘 다 명시(USD / 1M 토큰)
# LLM_BUDGET_FALLBACK_INPUT_PER_1M=
# LLM_BUDGET_FALLBACK_OUTPUT_PER_1M=
# 입력 토큰 상한 추정 = UTF-8 바이트 수 / 이 값. 1.0은 토크나이저와 무관한 상한이다. 실측한 뒤에만 올린다
# LLM_BUDGET_BYTES_PER_TOKEN=1.0
# 정산 없이 이 시간(초)을 넘긴 예약은 예약액 그대로 지출로 확정한다
# LLM_BUDGET_RESERVATION_TTL_S=900
# 요약 CLI의 원화 환산에만 쓰는 가정 환율
# LLM_BUDGET_KRW_PER_USD=1400
# 연속 인프라 실패(5xx·타임아웃·연결 오류) 몇 번에 런을 멈출지. 0이면 세지 않는다(HTTP 402는 항상 즉시 중단)
# LLM_CIRCUIT_BREAKER_THRESHOLD=5

# ========== 뉴스레터 품질 게이트 (docs/adr/0010) ==========
# 모두 선택 - 비워 두면 아래 기본값. 모드는 enforce(막고 재생성) / shadow(기록만) / off.
# 결정론적 사실성 게이트: 초안의 수치·인용이 클러스터 원문에 없으면 피드백과 함께 재생성
# FAITHFULNESS_GATE_MODE=enforce
# FAITHFULNESS_BLOCKING_TYPES=numbers,quotes    # entities는 정밀도 측정 전이라 참고용
# 문체 드리프트 게이트: 캐주얼 변환이 수치·날짜·고유명사를 바꾸면 재변환, 그래도 바뀌면 형식체 저장
# TONE_DRIFT_GATE_MODE=enforce
# TONE_DRIFT_BLOCKING_TYPES=numbers,dates,entities_added
# MAX_RETRY_TONE_DRIFT=1
# judge v2: shadow는 채점된 FAIL만 기록 후 통과(점수 없는 FAIL·생성기 폴백 초안은 계속 차단).
# ADR 0009 보정(OOF kappa >= 0.40)과 교차 계열 judge가 갖춰지기 전까지 shadow가 기본값이다.
# JUDGE_GATE_MODE=shadow
# JUDGE_MIN_CRITERION_SCORE=3                  # 기준별(1~5) 최저 점수 - 잠정값
# JUDGE_MAX_UNSUPPORTED_CLAIMS=0               # 허용하는 근거 없는 주장 수 - 잠정값
# Stage5 클러스터 병렬 처리 스레드 수(1~4로 제한 - DB 풀·프로바이더 레이트리밋 때문)
# NEWSLETTER_WORKERS=3

# ========== Naver HyperCLOVA X (레거시, 기본 프로바이더 아님) ==========
# 더 이상 기본으로 쓰지 않지만, GEN_PROVIDER=naver 등으로 명시하면 계속 쓸 수 있다.
# LLM_PROVIDER는 core/llm_client.py::get_llm_client()(레거시, 이제 파이프라인에서 호출되지
# 않음)만 참조하는 값이다 - role별 설정은 위 GEN_PROVIDER/JUDGE_PROVIDER/TONE_PROVIDER를 쓴다.
LLM_PROVIDER=naver
# Apps 방식 (nv-로 시작하는 키): API 키 하나만 설정
# Legacy 방식: 두 키 모두 설정 필요
NCP_CLOVASTUDIO_API_KEY=nv-your-api-key-here
# NCP_APIGW_API_KEY=your-apigw-key-here  # Legacy 방식일 때만 필요
# 지원 모델: HCX-003, HCX-DASH-001
HYPERCLOVA_MODEL=HCX-003

# ========== 정책브리핑 정책뉴스 (공공누리 제1유형, docs/adr/0023) ==========
# korea.kr RSS는 2026-07-01 중단. 같은 기사를 공공데이터포털 Open API로 받는다.
# https://www.data.go.kr/data/15095335/openapi.do 에서 활용신청(자동승인) 후 발급되는
# "일반 인증키(Decoding)"를 넣는다. 비워 두면 수집을 건너뛴다.
# DATA_GO_KR_SERVICE_KEY=

# ========== Database Configuration (PostgreSQL with pgvector) ==========
DB_HOST=localhost
DB_PORT=5432
DB_USER=recsys01
DB_PASSWORD=your-db-password-here
DB_NAME=final_db

# ========== Environment ==========
# dev, staging, prod
ENV=dev
# LLM_REQUEST_TIMEOUT_S=60            # 요청 1회 제한 시간(초)
# LLM_CALL_DEADLINE_S=180             # 재시도 포함 호출 1건의 전체 제한 시간(초)
