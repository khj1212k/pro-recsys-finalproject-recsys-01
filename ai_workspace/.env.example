# AI Workspace - LangGraph News Pipeline

# ========== LLM 클라이언트 (core/llm/, ADR 0005) ==========
# role(generator/judge/tone)별로 프로바이더/모델을 독립적으로 고른다.
# 프로바이더: openai | gemini | upstage | naver(레거시, 기본값 아님)
#
# 지금 기본으로 발급받은 키는 Gemini(Google Cloud 크레딧)뿐이므로, GEN/JUDGE/TONE
# 세 role 모두 gemini가 기본 프로바이더다 - 아래 GEMINI_API_KEY 하나만 있어도
# 파이프라인 전체가 동작한다. judge는 generator와 "다른 모델"(Flash vs
# Flash-Lite)을 기본값으로 쓰지만, 같은 벤더(gemini) 계열이라는 점 자체가
# LLM-as-judge의 self-preference bias 위험 요인이라 이 조합으로 judge를 만들 때마다
# WARNING 로그가 남는다(core/llm/registry.py::get_client) - 최종 프로바이더/모델
# 조합은 별도 bake-off ADR로 정한다.
#
# 모델을 비워두면 core/llm/registry.py의 ROLE_DEFAULT_MODEL/PROVIDER_CONFIG
# 기본값을 쓰지만, 운영에서는 아래처럼 명시하는 것을 권장한다. 모델 id는
# https://ai.google.dev/gemini-api/docs/models (접근일 2026-09-25) 기준 유효한
# id다 - 근거는 docs/adr/0005 참고.
#
# GEN_PROVIDER=gemini
# GEN_MODEL=gemini-3.5-flash-lite   # 초안 생성 - 비용 효율 우선
#
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-3.1-flash-lite # 평가 - generator와 다른 모델 (3.5-flash는 2026-09-25 프로브에서 타임아웃/503)
#
# TONE_PROVIDER=gemini
# TONE_MODEL=gemini-3.5-flash-lite  # 문체 변환 - 생성과 비슷한 비용 프로필

# ---------- Google Gemini (OpenAI 호환 엔드포인트) ----------
# https://generativelanguage.googleapis.com/v1beta/openai/ - AI Studio에서 키 발급
GEMINI_API_KEY=your-gemini-api-key-here

# ---------- 다른 프로바이더로 challenger를 시도할 때만 (선택) ----------
# JUDGE_PROVIDER/GEN_PROVIDER/TONE_PROVIDER를 openai 또는 upstage로 명시하지
# 않는 한 아래 키들은 필요 없다.

# Upstage Solar (OpenAI 호환 엔드포인트, 한국어 특화)
# https://api.upstage.ai/v1 - console.upstage.ai에서 키 발급
UPSTAGE_API_KEY=your-upstage-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------- 프로바이더별 레이트리밋(선택) ----------
# 초 단위 최소 호출 간격. 프로바이더당 클라이언트 인스턴스를 공유하므로
# (core/llm/registry.py) 여기서 설정하면 해당 프로바이더의 모든 role에 적용된다.
# GEMINI_LLM_MIN_INTERVAL=0.0
# UPSTAGE_LLM_MIN_INTERVAL=0.0
# OPENAI_LLM_MIN_INTERVAL=0.0

# ========== LLM 킬 스위치 (예정된 비용 가드용) ==========
# 실제 Google Cloud 과금이 시작되는 걸 감지하면 cron이 이 스위치를 켜서 모든 LLM
# 호출을 즉시 막는다(core/llm/kill_switch.py) - "1"/"true"/"yes" 중 하나면 켜짐.
# LLM_KILL_SWITCH=0
#
# 또는 아래 파일을 만들면(내용은 무관) 켜진다 - 기본 경로는 저장소 루트 기준
# <repo root>/.ops/LLM_KILL_SWITCH이며, 이 변수로 다른 경로를 지정할 수 있다.
# LLM_KILL_SWITCH_FILE=.ops/LLM_KILL_SWITCH

# ========== Naver HyperCLOVA X (레거시, 기본 프로바이더 아님) ==========
# 더 이상 기본으로 쓰지 않지만, GEN_PROVIDER=naver 등으로 명시하면 계속 쓸 수 있다.
# LLM_PROVIDER는 core/llm_client.py::get_llm_client()(레거시, 이제 파이프라인에서 호출되지
# 않음)만 참조하는 값이다 - role별 설정은 위 GEN_PROVIDER/JUDGE_PROVIDER/TONE_PROVIDER를 쓴다.
LLM_PROVIDER=naver
# Apps 방식 (nv-로 시작하는 키): API 키 하나만 설정
# Legacy 방식: 두 키 모두 설정 필요
NCP_CLOVASTUDIO_API_KEY=nv-your-api-key-here
# NCP_APIGW_API_KEY=your-apigw-key-here  # Legacy 방식일 때만 필요
# 지원 모델: HCX-003, HCX-DASH-001
HYPERCLOVA_MODEL=HCX-003

# ========== Database Configuration (PostgreSQL with pgvector) ==========
DB_HOST=localhost
DB_PORT=5432
DB_USER=recsys01
DB_PASSWORD=your-db-password-here
DB_NAME=final_db

# ========== Environment ==========
# dev, staging, prod
ENV=dev
# LLM_REQUEST_TIMEOUT_S=60            # 요청 1회 제한 시간(초)
# LLM_CALL_DEADLINE_S=180             # 재시도 포함 호출 1건의 전체 제한 시간(초)
