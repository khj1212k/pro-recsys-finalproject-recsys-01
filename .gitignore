# ==========================
# 1. 공통 및 IDE 설정
# ==========================
# 운영체제 파일
.DS_Store
Thumbs.db
Desktop.ini

# VS Code 및 에디터 설정
.vscode/
.idea/
*.swp
*.swo

# ==========================
# 2. 보안 및 환경 변수 (★가장 중요)
# ==========================
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# ==========================
# 3. Python (Backend & AI 공통)
# ==========================
# 컴파일된 파일
__pycache__/
*.py[cod]
*.pyc
*$py.class

# 가상환경 (이름이 다양할 수 있어서 다 넣어둠)
.venv/
venv/
env/
ENV/
.venv-*/

# 배포 및 라이브러리
dist/
build/
*.egg-info/
.eggs/

# Jupyter Notebook (AI 팀용)
.ipynb_checkpoints/
*.ipynb

# 로그
*.log

# 추천모델 학습용 임시 데이터 파일
newsletter_share.json

# 추천모델을 위한 임시 임베딩 파일
ai_workspace/recommend_engine/data
ai_workspace/recommend_engine/results

# ==========================
# 4. AI & 데이터 (AI Workspace)
# ==========================
# 무거운 모델 파일 (GitHub 용량 초과 방지)
*.pt
*.pth
*.h5
*.onnx
*.pkl

# 데이터셋 (CSV, Excel 등)
# 필요하다면 주석(#)을 풀어서 커밋에 포함시키세요.
# *.csv
# *.xlsx
# data/

# 크롤링 결과물 등
ai_workspace/data/
ai_workspace/output/
ai_workspace/logs/

# ==========================
# 5. Frontend (React/Node)
# ==========================
# 의존성 패키지 (용량이 매우 큼, 절대 올리면 안 됨)
node_modules/

# 빌드 결과물
frontend/build/
frontend/dist/

# 패키지 매니저 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# 6. 기타
# ==========================
# Postgres 데이터 (Docker 사용 시)
postgres_data/

# Alembic 자동 생성 캐시 (필요시)
backend/__pycache__/

node_modules/
frontend/node_modules/

# ==========================
# 7. Airflow
# ==========================
backend/airflow/*
!backend/airflow/dags/
ai_workspace/airflow_home/
ai_workspace/dags/__pycache__/

# ==========================
# 8. AI Workspace Test & Temp Files
# ==========================
# Test files
ai_workspace/test_*.py
ai_workspace/*_test.py

# Generated data and outputs
ai_workspace/*.json
ai_workspace/*.txt
ai_workspace/*.md
!ai_workspace/README.md
!ai_workspace/PROJECT_OVERVIEW.md

# Backup files
ai_workspace/.env.backup
ai_workspace/*.backup

# Pytest
ai_workspace/.pytest_cache/

# ==========================
# 9. Non-production (keep local, don't track)
# ==========================
ai_workspace/newsletter_audit.md
ai_workspace/tests/
ai_workspace/scripts/
ai_workspace/test/
ai_workspace/docs/

# ==========================
# 10. 재현성 산출물 및 로컬 도구 상태 (self-review #4)
# ==========================
# 원본 데이터셋 (repo 루트 기준)
/data/
# 리포트 내 원본(raw) 산출물 - 정제된 리포트 본문만 추적
reports/**/raw/
# MLflow 실험 추적 로컬 저장소
mlruns/
# 학습 체크포인트
checkpoints/
# 로컬 도구 상태 (커밋하지 않음)
.claude/

# 로컬 운영 상태(LLM 킬 스위치, 예산 가드 상태 등) - docs/runbook.md 6절
.ops/
