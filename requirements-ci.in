rapidfuzz==3.14.6
pydantic==2.13.5
pyyaml==6.0.3
uvicorn==0.54.0

# (2) API 이미지(backend/requirements.txt)와 같은 버전 - 라우터 테스트가 이미지가 싣는 FastAPI에서 돈다.
# sqlalchemy·sqlmodel: 고정하지 않은 설치가 SQLAlchemy 2.1.4를 받아 postgresql:// 기본 드라이버가 psycopg2에서
# psycopg(v3)로 바뀌며 main의 CI가 깨졌다(PR #26). bcrypt는 passlib 1.7.4가 bcrypt 5에서 ValueError를 내서 묶는다.
fastapi==0.117.1
python-jose==3.5.0
passlib==1.7.4
bcrypt==3.2.2
sqlalchemy==2.0.46
sqlmodel==0.0.31

